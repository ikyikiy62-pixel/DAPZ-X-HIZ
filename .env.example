# Gemini API key. Never commit the real key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# IDR input price per 1,000,000 tokens.
# Defaults are placeholders; set these to the current provider prices before production use.
GPT4O_INPUT_IDR_PER_1M=125000
CLAUDE_INPUT_IDR_PER_1M=75000
