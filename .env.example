# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Google OAuth Web Client ID (public; safe for browser use).
# This is used by Google Identity Services so login can return directly to the app
# instead of using Supabase's hosted OAuth redirect page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Gemini API key. Never commit the real key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# IDR input price per 1,000,000 tokens.
GPT4O_INPUT_IDR_PER_1M=125000
CLAUDE_INPUT_IDR_PER_1M=75000
